<Application x:Class="AFKPowerSaver.OverlayCanary.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#0B1016" />
        <SolidColorBrush x:Key="PanelBackground" Color="#131B24" />
        <SolidColorBrush x:Key="PanelBorder" Color="#253242" />
        <SolidColorBrush x:Key="PrimaryText" Color="#F2F7FB" />
        <SolidColorBrush x:Key="SecondaryText" Color="#9EB0C2" />
        <SolidColorBrush x:Key="Accent" Color="#67E8A5" />

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="#07120D" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="20,12" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Application.Resources>
</Application>
