<Window x:Class="EcoPause.Desktop.ClosePreferenceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AFK Power Saver"
        Width="520"
        Height="275"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackground}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="19"
                   FontWeight="SemiBold"
                   Text="Keep AFK Power Saver running?" />
        <TextBlock Grid.Row="1"
                   Margin="0,12,0,0"
                   Foreground="{StaticResource SecondaryText}"
                   TextWrapping="Wrap"
                   Text="Minimise to the notification area to keep the hotkey and idle activation available, or exit and restore all original settings." />
        <CheckBox x:Name="RememberChoiceCheckBox"
                  Grid.Row="2"
                  Margin="0,22,0,0"
                  VerticalAlignment="Top"
                  Foreground="{StaticResource PrimaryText}"
                  Content="Don't show this message again" />

        <StackPanel Grid.Row="3"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Margin="0,0,10,0"
                    MinWidth="145"
                    Style="{StaticResource SecondaryButton}"
                    Content="Exit and restore"
                    Click="ExitButton_Click" />
            <Button MinWidth="165"
                    Style="{StaticResource PrimaryButton}"
                    Content="Minimise to tray"
                    IsDefault="True"
                    Click="MinimizeButton_Click" />
        </StackPanel>
    </Grid>
</Window>
