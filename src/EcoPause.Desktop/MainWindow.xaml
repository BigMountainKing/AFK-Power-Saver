<Window x:Class="EcoPause.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AFK Power Saver"
        Width="1420"
        Height="970"
        MinWidth="1120"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Closed="Window_Closed">
    <ScrollViewer Background="{StaticResource WindowBackground}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="30,24,30,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Product header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="60"
                        Height="60"
                        CornerRadius="13"
                        Background="#102B2B"
                        BorderBrush="#2A8E82"
                        BorderThickness="1">
                    <TextBlock Text="&#xE945;"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="30"
                               Foreground="{StaticResource Accent}" />
                </Border>

                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Text="AFK Power Saver"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="31"
                           FontWeight="SemiBold" />

                <Border Grid.Column="3"
                        Padding="12,7"
                        CornerRadius="15"
                        Background="#123629"
                        BorderBrush="#276749"
                        BorderThickness="1"
                        VerticalAlignment="Top">
                    <TextBlock Text="1.24.0 RC"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource Accent}" />
                </Border>
            </Grid>

            <!-- At-a-glance status strip -->
            <Border Grid.Row="2"
                    Padding="20,13"
                    CornerRadius="12"
                    Background="#0F1A24"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1.2*" />
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="StatusDot"
                                 Width="12"
                                 Height="12"
                                 Margin="0,0,12,0"
                                 VerticalAlignment="Center"
                                 Fill="{StaticResource Accent}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="SYSTEM STATUS"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource Accent}" />
                            <TextBlock x:Name="StatusText"
                                       Margin="0,3,0,0"
                                       Text="Starting live safety session..."
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE7F8;"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="25"
                                   Foreground="#2DD4BF" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="CURRENT LIMIT"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource SecondaryText}" />
                            <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                <TextBlock x:Name="GpuLimitText"
                                           Text="-- W"
                                           FontSize="20"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="GpuUsageText"
                                           Margin="12,5,0,0"
                                           Text="Draw -- W"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryText}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="ActivityDot"
                                 Width="12"
                                 Height="12"
                                 Margin="0,0,12,0"
                                 VerticalAlignment="Center"
                                 Fill="#60A5FA" />
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="ActivityStatusText"
                                       Text="Starting Windows activity monitor..."
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ActivityDetailText"
                                       Margin="0,3,0,0"
                                       Text="Idle activation is off"
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryText}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Three equal capability cards -->
            <UniformGrid Grid.Row="4" Columns="3">
                <Border Margin="0,0,8,0"
                        Padding="22"
                        MinHeight="300"
                        Style="{StaticResource FeatureCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7F8;"
                                           Margin="0,0,10,0"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="22"
                                           Foreground="#2DD4BF" />
                                <TextBlock Text="GPU"
                                           FontSize="20"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                            <CheckBox x:Name="GpuLimitCheckBox"
                                      Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"
                                      Checked="GpuLimitControl_Changed"
                                      Unchecked="GpuLimitControl_Changed"
                                      AutomationProperties.Name="Enable GPU power limiting" />
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="0,24,0,0">
                            <TextBlock x:Name="LiveTargetValueText"
                                       Text="89%"
                                       HorizontalAlignment="Center"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       FontSize="42"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="GpuNameText"
                                       Margin="0,5,0,0"
                                       Text="Loading read-only GPU data..."
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryText}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="0,23,0,0" VerticalAlignment="Center">
                            <Slider x:Name="LivePowerSlider"
                                    Minimum="1"
                                    Maximum="99"
                                    Value="89"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="LivePowerSlider_ValueChanged"
                                    AutomationProperties.Name="Real GPU power percentage" />
                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Power limit"
                                           FontSize="12"
                                           Foreground="{StaticResource SecondaryText}" />
                                <TextBlock x:Name="GpuRangeText"
                                           Grid.Column="1"
                                           Text="Range -- W"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryText}" />
                            </Grid>
                        </StackPanel>

                        <TextBlock x:Name="LivePowerRangeText"
                                   Grid.Row="3"
                                   Margin="0,18,0,0"
                                   Text="Waiting for GPU-relative range..."
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontSize="10"
                                   Foreground="{StaticResource SecondaryText}" />
                    </Grid>
                </Border>

                <Border Margin="4,0"
                        Padding="22"
                        MinHeight="300"
                        Style="{StaticResource FeatureCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE950;"
                                           Margin="0,0,10,0"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="22"
                                           Foreground="#2DD4BF" />
                                <TextBlock Text="CPU"
                                           FontSize="20"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                            <CheckBox x:Name="CpuLimitCheckBox"
                                      Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"
                                      Checked="CpuLimitControl_Changed"
                                      Unchecked="CpuLimitControl_Changed"
                                      AutomationProperties.Name="Enable optional CPU limit" />
                        </Grid>

                        <TextBlock x:Name="CpuLimitValueText"
                                   Grid.Row="1"
                                   Margin="0,29,0,0"
                                   Text="80%"
                                   HorizontalAlignment="Center"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="48"
                                   FontWeight="SemiBold" />

                        <StackPanel Grid.Row="2" Margin="0,23,0,0" VerticalAlignment="Center">
                            <Slider x:Name="CpuLimitSlider"
                                    Minimum="20"
                                    Maximum="99"
                                    Value="80"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="CpuLimitSlider_ValueChanged"
                                    AutomationProperties.Name="CPU maximum processor state percentage" />
                            <TextBlock Margin="0,9,0,0"
                                       Text="Maximum processor state"
                                       HorizontalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{StaticResource SecondaryText}" />
                        </StackPanel>

                        <TextBlock x:Name="CpuLimitStatusText"
                                   Grid.Row="3"
                                   Margin="0,18,0,0"
                                   Text="Optional - changes the active Windows power plan"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontSize="10"
                                   Foreground="{StaticResource SecondaryText}" />
                    </Grid>
                </Border>

                <Border Margin="8,0,0,0"
                        Padding="22"
                        MinHeight="300"
                        Style="{StaticResource FeatureCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7F4;"
                                           Margin="0,0,10,0"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="22"
                                           Foreground="#2DD4BF" />
                                <TextBlock Text="DISPLAY"
                                           FontSize="20"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                            <CheckBox x:Name="ScreenDimmingCheckBox"
                                      Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"
                                      Checked="ScreenDimmingControl_Changed"
                                      Unchecked="ScreenDimmingControl_Changed"
                                      AutomationProperties.Name="Enable screen dimming with live limit" />
                        </Grid>

                        <TextBlock x:Name="OverlayOpacityValueText"
                                   Grid.Row="1"
                                   Margin="0,20,0,0"
                                   Text="70%"
                                   HorizontalAlignment="Center"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="42"
                                   FontWeight="SemiBold" />

                        <StackPanel Grid.Row="2" Margin="0,13,0,0">
                            <Slider x:Name="OverlayOpacitySlider"
                                    Minimum="10"
                                    Maximum="95"
                                    Value="70"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="OverlayOpacitySlider_ValueChanged"
                                    AutomationProperties.Name="Screen dimming opacity percentage" />
                            <TextBlock Margin="0,7,0,0"
                                       Text="Dim opacity"
                                       HorizontalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{StaticResource SecondaryText}" />
                        </StackPanel>

                        <ToggleButton x:Name="DisplayTargetButton"
                                      Grid.Row="3"
                                      Margin="0,14,0,0"
                                      Padding="10,7"
                                      HorizontalContentAlignment="Left"
                                      Style="{StaticResource DropDownButton}"
                                      Content="Select display"
                                      AutomationProperties.Name="Select displays to dim" />

                        <Popup x:Name="DisplayTargetPopup"
                               Grid.Row="3"
                               PlacementTarget="{Binding ElementName=DisplayTargetButton}"
                               Placement="Bottom"
                               IsOpen="{Binding IsChecked, ElementName=DisplayTargetButton, Mode=TwoWay}"
                               AllowsTransparency="True"
                               StaysOpen="False"
                               PopupAnimation="Fade">
                            <Border MinWidth="360"
                                    Margin="0,4,0,0"
                                    Padding="8"
                                    Background="#111B24"
                                    BorderBrush="#385065"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                <StackPanel>
                                    <TextBlock Margin="8,4,8,7"
                                               Text="SELECT DISPLAY(S)"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource Accent}" />
                                    <ItemsControl x:Name="DisplayTargetItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Margin="8,5"
                                                          Content="{Binding DisplayName}"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          Foreground="{StaticResource PrimaryText}"
                                                          Checked="DisplayTargetOption_Changed"
                                                          Unchecked="DisplayTargetOption_Changed" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <TextBlock x:Name="ScreenDimmingStatusText"
                                   Grid.Row="4"
                                   Margin="0,10,0,0"
                                   Text="Screen dimming is off"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontSize="10"
                                   Foreground="{StaticResource SecondaryText}" />
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- Manual and automatic activation settings -->
            <Border Grid.Row="6"
                    Padding="18,13"
                    CornerRadius="11"
                    Background="#101B25"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Margin="0,0,18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="9" />
                            <ColumnDefinition Width="95" />
                            <ColumnDefinition Width="9" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="GLOBAL HOTKEY"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="Bold" />
                        <ComboBox x:Name="HotKeyModifiersComboBox"
                                  Grid.Column="2"
                                  Padding="10,6"
                                  Tag="Select hotkey 1"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="HotKeySelection_Changed"
                                  AutomationProperties.Name="Hotkey modifiers" />
                        <ComboBox x:Name="HotKeyKeyComboBox"
                                  Grid.Column="4"
                                  Padding="10,6"
                                  Tag="Select hotkey 2"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="HotKeySelection_Changed"
                                  AutomationProperties.Name="Hotkey key" />
                        <Button x:Name="ApplyHotKeyButton"
                                Grid.Column="6"
                                Style="{StaticResource SecondaryButton}"
                                Content="Save hotkey"
                                Click="ApplyHotKeyButton_Click" />
                    </Grid>

                    <Grid Grid.Column="1" Margin="18,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="13" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="IdleActivationCheckBox"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource ToggleSwitch}"
                                  Checked="IdleActivationControl_Changed"
                                  Unchecked="IdleActivationControl_Changed"
                                  AutomationProperties.Name="Enable idle timer activation" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="IDLE ACTIVATION"
                                           FontSize="12"
                                           FontWeight="Bold" />
                                <TextBlock x:Name="IdleMinutesValueText"
                                           Grid.Column="1"
                                           Text="5 min"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Accent}" />
                            </Grid>
                            <Slider x:Name="IdleMinutesSlider"
                                    Margin="0,3,0,0"
                                    Minimum="1"
                                    Maximum="120"
                                    Value="5"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="IdleMinutesSlider_ValueChanged"
                                    AutomationProperties.Name="Idle activation delay in minutes" />
                        </StackPanel>
                        <TextBlock x:Name="IdleActivationStatusText"
                                   Grid.Column="3"
                                   Width="150"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="Off"
                                   TextAlignment="Right"
                                   TextWrapping="Wrap"
                                   FontSize="10"
                                   Foreground="{StaticResource SecondaryText}" />
                    </Grid>

                    <Grid Grid.Column="2" Margin="22,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="LaunchOnStartupCheckBox"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource ToggleSwitch}"
                                  Checked="LaunchOnStartupControl_Changed"
                                  Unchecked="LaunchOnStartupControl_Changed"
                                  AutomationProperties.Name="Launch AFK Power Saver when signing in" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="WINDOWS STARTUP"
                                       FontSize="12"
                                       FontWeight="Bold" />
                            <TextBlock x:Name="StartupStatusText"
                                       Margin="0,3,0,0"
                                       Text="Off"
                                       FontSize="10"
                                       Foreground="{StaticResource SecondaryText}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Single primary action -->
            <Grid Grid.Row="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button x:Name="LiveToggleButton"
                        MinHeight="68"
                        Style="{StaticResource LiveButton}"
                        Content="ACTIVATE LIMITS"
                        FontSize="22"
                        Click="LiveToggleButton_Click"
                        AutomationProperties.Name="Toggle real GPU, CPU, and display limits" />
                <ProgressBar x:Name="RunProgress"
                             Height="4"
                             Margin="20,-7,20,0"
                             VerticalAlignment="Bottom"
                             IsIndeterminate="True"
                             Foreground="{StaticResource Accent}"
                             Background="#6B4E0F"
                             Visibility="Collapsed" />
                <StackPanel Grid.Row="1" Margin="0,7,0,0">
                    <TextBlock x:Name="LiveToggleStatusText"
                               Text="Waiting for strict live GPU preflight..."
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryText}" />
                    <TextBlock x:Name="HotKeyStatusText"
                               Margin="0,3,0,0"
                               Text="Registering global live-toggle hotkey..."
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryText}" />
                </StackPanel>
            </Grid>

            <!-- Secondary commands and optional tip entry point -->
            <Border Grid.Row="10"
                    Padding="14,10"
                    CornerRadius="10"
                    Background="#0D151D"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="RefreshGpuButton"
                            Style="{StaticResource SecondaryButton}"
                            Content="Refresh GPU data"
                            Click="RefreshGpuButton_Click"
                            AutomationProperties.Name="Refresh read-only GPU data" />
                    <TextBlock x:Name="FooterGpuUsageText"
                               Grid.Column="1"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               Text="GPU power: waiting for refresh"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryText}" />
                    <TextBlock Grid.Column="3"
                               VerticalAlignment="Center"
                               Text="If you found the app useful, please consider leaving a tip :) "
                               FontSize="12"
                               Foreground="{StaticResource SecondaryText}" />
                    <Button x:Name="SupportButton"
                            Grid.Column="5"
                            Style="{StaticResource SecondaryButton}"
                            Content="Leave a tip"
                            Click="SupportButton_Click"
                            AutomationProperties.Name="Open optional tip options" />
                </Grid>
            </Border>

            <Popup x:Name="SupportPopup"
                   Grid.Row="10"
                   PlacementTarget="{Binding ElementName=SupportButton}"
                   Placement="Top"
                   HorizontalOffset="0"
                   VerticalOffset="-6"
                   AllowsTransparency="True"
                   StaysOpen="False"
                   PopupAnimation="Fade">
                <Border Width="380"
                        Padding="14"
                        CornerRadius="9"
                        Background="#15212C"
                        BorderBrush="#385065"
                        BorderThickness="1">
                    <ScrollViewer MaxHeight="700" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="LEAVE A TIP"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource Accent}" />
                            <TextBlock Margin="0,4,0,10"
                                       Text="PayPal"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                            <Border Padding="10"
                                    HorizontalAlignment="Center"
                                    Background="#F7F9FC"
                                    CornerRadius="7">
                                <Image Width="170"
                                       Height="170"
                                       Source="pack://application:,,,/Assets/PayPalQr.png"
                                       Stretch="Uniform"
                                       AutomationProperties.Name="PayPal tip QR code" />
                            </Border>
                            <Button x:Name="OpenPayPalTipButton"
                                    Margin="0,10,0,0"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Open PayPal"
                                    Click="OpenPayPalTipButton_Click"
                                    AutomationProperties.Name="Open secure PayPal tip link" />

                            <StackPanel x:Name="CryptoTipSection" Margin="0,15,0,0">
                                <TextBlock Text="CRYPTOCURRENCY"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource Accent}" />
                                <TextBlock Margin="0,4,0,7"
                                           Text="Check the currency and network before sending."
                                           FontSize="10"
                                           Foreground="{StaticResource SecondaryText}" />
                                <ItemsControl x:Name="CryptoTipItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,4,0,0"
                                                    Padding="9,7"
                                                    Background="#192631"
                                                    CornerRadius="5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Label}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Margin="0,2,8,0"
                                                                   Text="{Binding DisplayAddress}"
                                                                   ToolTip="{Binding Address}"
                                                                   FontFamily="Cascadia Mono, Consolas"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource SecondaryText}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Padding="10,5"
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Content="Copy"
                                                            Tag="{Binding Address}"
                                                            Click="CopyCryptoAddressButton_Click" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <TextBlock x:Name="PaymentTipStatusText"
                                       Margin="0,10,0,0"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       FontSize="10"
                                       Foreground="{StaticResource SecondaryText}" />
                            <TextBlock Margin="0,7,0,0"
                                       Text="Tips are optional and do not unlock features."
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       FontSize="10"
                                       Foreground="{StaticResource SecondaryText}" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Popup>

            <!-- Log stays available without competing with the primary workflow. -->
            <Expander Grid.Row="12"
                      Header="Safety log"
                      Foreground="{StaticResource PrimaryText}"
                      Background="#0D151D"
                      BorderBrush="{StaticResource PanelBorder}"
                      BorderThickness="1"
                      Padding="12,8"
                      IsExpanded="False">
                <TextBox x:Name="OutputTextBox"
                         Height="125"
                         Margin="0,9,0,0"
                         Padding="12"
                         Background="#090E13"
                         Foreground="#B8C9D8"
                         BorderThickness="0"
                         FontFamily="Cascadia Mono, Consolas"
                         FontSize="11"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="AFK Power Saver safety log"
                         Text="Ready. Configure the limit profile, then use the single activation button, hotkey, or optional idle timer.&#x0a;" />
            </Expander>
        </Grid>
    </ScrollViewer>
</Window>
