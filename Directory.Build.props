<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Version>1.24.0</Version>
    <AssemblyVersion>1.24.0.0</AssemblyVersion>
    <FileVersion>1.24.0.0</FileVersion>
    <Product>AFK Power Saver</Product>
    <Company>AFK Power Saver</Company>
    <Description>Reduce selected PC power limits while away and restore the original settings exactly.</Description>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/.work/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
